{
  "name": "opencode-resume-checkpoint",
  "version": "0.1.0",
  "description": "Rolling checkpoints, stale-todo reconciliation, and a /resume skill for OpenCode interrupted sessions.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "resume",
    "checkpoint",
    "session",
    "todos",
    "ai"
  ],
  "homepage": "https://github.com/engida32/opencode-resume-checkpoint#readme",
  "bugs": {
    "url": "https://github.com/engida32/opencode-resume-checkpoint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engida32/opencode-resume-checkpoint.git"
  },
  "license": "MIT",
  "author": "engida32",
  "type": "module",
  "main": "dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./server": "./dist/plugin.js"
  },
  "bin": {
    "opencode-resume-checkpoint": "scripts/install.js"
  },
  "files": [
    "dist",
    "src",
    "commands",
    "skills",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "esbuild src/plugin.js --bundle --platform=node --format=esm --external:@opencode-ai/plugin --outfile=dist/plugin.js --sourcemap",
    "prepare": "npm run build",
    "test": "npm run build && node --test",
    "check": "node --check src/plugin.js && node --check src/checkpoint.js && node --check src/redact.js && node --check src/git.js && node --check scripts/install.js && node --check scripts/install-lib.js",
    "pack": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.25",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
